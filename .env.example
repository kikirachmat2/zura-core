# ⚡ ZURA AUTONOMOUS PERSONAL AI — CONFIGURATION TEMPLATE

# 1. Telegram Bot Gateway
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ZURA_BOT_USERNAME=zura_pa_bot

# 2. AI Reasoning Engines
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Voice Synthesizer & Transcriber
VOICE_NAME_ID=id-ID-GadisNeural
VOICE_NAME_EN=en-US-JennyNeural
STT_MODEL=whisper-large-v3

# 4. Multi-Server Nodes
SERVER1_HOST=192.168.1.100
SERVER1_TAILSCALE=100.64.0.1
SERVER1_USER=ubuntu
SERVER1_KEY=path_to_ssh_key

SERVER2_HOST=192.168.1.101
SERVER2_USER=ubuntu
SERVER2_KEY=path_to_ssh_key

# 5. OCI Batam Sniper Target
OCI_BATAM_REGION=ap-batam-1
OCI_BATAM_AD=your_ad_name
OCI_BATAM_SUBNET=your_subnet_ocid
OCI_BATAM_IMAGE=your_image_ocid
OCI_BATAM_COMPARTMENT=your_compartment_ocid
OCI_BATAM_KEY=path_to_oci_pem

# 6. Autonomic Thresholds
MAC_TEMP_MAX_C=62.0
MAC_TEMP_MIN_C=35.0
SERVER_RAM_MAX_PCT=85.0
SERVER_DISK_MAX_PCT=75.0
WIFI_MAX_LATENCY_MS=90.0

# 7. Aggressive Hotspot Failover
PERSONAL_HOTSPOT_SSID=MyPersonalHotspot
PERSONAL_HOTSPOT_PASS=your_hotspot_password


