# ==============================================================================
# ZURA AUTONOMIC OPERATIONAL LIMITS & THRESHOLDS (NON-SECRET)
# ==============================================================================
# This file defines runtime parameters, hardware thresholds, and rate limits.
# DO NOT store secret keys, tokens, or credentials here.
# Safe to commit or configure independently of .env secrets.

# 1. Hardware & System Thresholds
MAC_TEMP_MAX_C=62.0
MAC_TEMP_MIN_C=35.0
SERVER_RAM_MAX_PCT=85.0
SERVER_DISK_MAX_PCT=75.0
WIFI_MAX_LATENCY_MS=90.0

# 2. Rate Limits (Cooldowns in Seconds)
RATE_LIMIT_SERVER_RESTART_SEC=3600.0
RATE_LIMIT_KIBOT_RESTART_SEC=3600.0
RATE_LIMIT_KIBOT_TUNE_SEC=3600.0
RATE_LIMIT_WIFI_RECONNECT_SEC=300.0
RATE_LIMIT_MAC_PURGE_CACHE_SEC=600.0
RATE_LIMIT_THREADS_REPLENISH_SEC=180.0

# 3. Threads & Content Governance Limits
THREADS_DAILY_REPLENISH_CAP=5
THREADS_MIN_QUEUE_THRESHOLD=2
THREADS_ANGER_CRITICISM_THRESHOLD_PCT=25.0

