[Unit]
Description=Zura GitOps Decoupled Updater & Heartbeat Verifier
After=network.target

[Service]
Type=oneshot
User=zura-ops
WorkingDirectory=/home/zura-ops/zura-core
ExecStart=/usr/bin/python3 /home/zura-ops/zura-core/.git/safe_updater.py
TimeoutStartSec=360
StandardOutput=journal
StandardError=journal

