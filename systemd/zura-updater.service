[Unit]
Description=Zura GitOps Decoupled Updater & Heartbeat Verifier
After=network.target

[Service]
Type=oneshot
User=zura-ops
WorkingDirectory=/home/zura-ops/zura-core
ExecStart=/home/zura-ops/zura-core/venv/bin/python3 /home/zura-ops/zura-core/scripts/zura_updater.py
TimeoutStartSec=180
TimeoutSec=180
StandardOutput=journal
StandardError=journal

